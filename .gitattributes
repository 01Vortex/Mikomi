# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.arb text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
*.xcconfig text eol=lf
*.plist text eol=lf
*.entitlements text eol=lf
*.xcscheme text eol=lf
*.iml text eol=lf
*.bat text eol=lf
*.ps1 text eol=lf

# Binary files - never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.jar binary
*.aar binary
